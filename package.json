{
  "name": "mcp-sqlserver",
  "version": "1.1.0",
  "description": "MCP Server for SQL Server — Full database introspection, data querying, performance monitoring, and integrity analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-sqlserver": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "validate:skills": "node .claude/skills/buenas-practicas-sql/references/validar.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sql-server",
    "mssql",
    "database",
    "ai",
    "llm"
  ],
  "author": "Morro",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^17.3.1",
    "mssql": "^11.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
